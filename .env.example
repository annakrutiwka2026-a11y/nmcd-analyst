# Скопируйте в .env и заполните. Все переменные необязательны:
# без ключей сервис работает по правилам и ищет цены только в ЕИС.

# Языковая модель (Anthropic-совместимый API): разбор ТЗ и сверка характеристик.
LLM_API_KEY=
# Адрес API, если используется не api.anthropic.com (например, корпоративный шлюз).
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-5
# Предел токенов на один расчёт (защита от перерасхода).
LLM_MAX_TOKENS_PER_RUN=600000

# Яндекс Search API v2 (AI Studio): поиск предложений на сайтах поставщиков.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Наименование организации для свойств и шапки документов.
NMCD_ORG_NAME=Заказчик
# Контактный адрес организации для User-Agent при запросах к сайтам (необязательно).
NMCD_CONTACT_URL=
# 1 — не использовать модель (режим «контур заказчика»: ТЗ не покидает сервер) или веб-поиск.
NMCD_DISABLE_LLM=
NMCD_DISABLE_WEB=
# Порт веб-интерфейса на хосте.
NMCD_PORT=8000

# Общедоступный стенд: 1 — на главной каждый видит только свои расчёты.
NMCD_PUBLIC=
# Сколько расчётов может ждать и идти одновременно.
NMCD_MAX_QUEUE=6
# Предел токенов модели в сутки на весь сервис (0 — без предела).
LLM_DAILY_TOKEN_BUDGET=0
